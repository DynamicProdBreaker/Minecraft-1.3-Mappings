	f	[B	a	f_53106985
		c	Unused buffer to store a single 4KB block of memory.
	f	Ljava/io/File;	b	f_98211020
	f	Ljava/io/RandomAccessFile;	c	f_36282442
	f	[I	d	f_27641308
		c	Contains the 4KB block offset and number of blocks that each chunk occupies. If\na chunk does not store any data, then the array entry contains zero. The format\nof a non-zero entry in the array is as follows:\n<ul>\n    <li>bits[0:7] , the number of blocks that the chunk data occupies</li>\n    <li>bits[8:31], the block offset of the first byte in the chunk data</li>\n</ul>\nThe above is specified in lsb first. This array is also written to the region\nfile starting at byte 0.\n<br><br>\nNote: A block in this context should be understood as 4096 continous bytes in\nthe region file.
	f	[I	e	f_89227874
		c	Contains the times for the latest modification to each chunk. This array\nis also written to the region file starting at byte 4096 (block offset 1).
	f	Ljava/util/ArrayList;	f	f_94239037
		c	A list containing flags for each of the 4KB blocks in the file indicating whether\nit should be considered empty or occupied. In particular, if a value at index\n{@code blockOffset} is {@code true} then it is empty, and otherwise occupied.
	f	I	g	f_49201041
		c	The total number of bytes written to the region file, since this {@code RegionFile}\nobject was instantiated. Note that this is always a multiple of 4096 (the size\nof a single 4KB block).
	f	J	h	f_93534305
	m	(Ljava/io/File;)V	<init>	<init>
	m	(II)Ljava/io/DataInputStream;	a	m_88766766
	m	(II)Ljava/io/DataOutputStream;	b	m_68205534
	m	(II[BI)V	a	m_77819097
		c	Writes the chunk data at the given coordinates to the region file. Any\nprevious chunk data at the same coordinates will be discarded.
	m	(I[BI)V	a	m_90052038
		c	Writes the given chunk data to the specified block offset.
	m	(II)Z	d	m_06104323
	m	(II)I	e	m_20685684
		c	@return The chunk block info for the chunk at the specified location. See\n        {@link #chunkBlockInfo} for information about the format of the\n        block info.
	m	(II)Z	c	m_06356153
		c	@return True, if this region file contains chunk data for the specified\n        coordinates, false otherwise.
	m	(III)V	a	m_39651857
		c	Writes the given chunk block info to the region file. See {@link #chunkBlockInfo}\nfor information about the format of the block info.
